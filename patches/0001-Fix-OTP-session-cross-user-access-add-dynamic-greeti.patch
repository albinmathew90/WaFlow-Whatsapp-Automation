+@Injectable()
+export class OtpLogsService {
+  constructor(
+    @InjectRepository(OtpRequest, 'data')
+    private readonly requestRepo: Repository<OtpRequest>,
+    @InjectRepository(OtpWebhookDelivery, 'data')
