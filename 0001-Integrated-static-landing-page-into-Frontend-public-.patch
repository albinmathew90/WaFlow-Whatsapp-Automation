+/* Features Page Specific CSS */
+.features-page { padding-bottom: 100px; }
+.feature-page-row {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 60px;
+  align-items: center;
+  padding: 60px 0;
+  border-bottom: 1px solid #EEF1F5;
+}
+.feature-page-row:last-child {
+  border-bottom: none;
+}
+.feature-page-row .feature-text {
+  order: 1;
+}
+.feature-page-row .feature-image {
+  order: 2;
+}
+.feature-page-row.even-row .feature-text {
+  order: 2;
+}
+.feature-page-row.even-row .feature-image {
+  order: 1;
+}
+
+.feature-text .num {
+  font-size: 20px;
+  font-weight: 700;
+  color: var(--ink);
+  margin-bottom: 12px;
+  display: block;
+}
+.feature-text .desc {
+  font-size: 15.5px;
+  color: var(--slate);
+  margin-bottom: 24px;
+}
+.feature-text ul {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+.feature-text ul li {
+  font-size: 14px;
+  color: var(--slate);
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+}
+.feature-text ul li::before {
+  content: "";
+  flex-shrink: 0;
+  margin-top: 6px;
+  width: 7px;
+  height: 7px;
+  border-radius: 2px;
+  background: var(--green-gradient);
+  transform: rotate(45deg);
+}
+.feature-image-placeholder {
+  width: 100%;
+  aspect-ratio: 4/3;
+  border: 2px dashed #CBD5E1;
+  border-radius: 16px;
+  background: #F8FAFC;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  color: #94A3B8;
+  font-size: 14px;
+  text-align: center;
+  gap: 8px;
+}
+
+@media (max-width: 980px) {
+  .feature-page-row {
+    grid-template-columns: 1fr;
+    gap: 34px;
+    padding: 44px 0;
+  }
+  /* Mobile order: Text always top (1), Image always bottom (2) */
+  .feature-page-row .feature-text,
+  .feature-page-row.even-row .feature-text {
+    order: 1;
+  }
+  .feature-page-row .feature-image,
+  .feature-page-row.even-row .feature-image {
+    order: 2;
+  }
+}
