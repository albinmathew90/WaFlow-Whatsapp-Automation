+<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+
+<header>
+  <div class="wrap nav-row">
+    <a href="index.html" class="logo" style="display:flex;align-items:center;text-decoration:none;">
+      <!-- Paste your image URL in the src attribute below -->
+      <img src="images\logo-light-removebg-preview.png" alt="Brand Logo" style="height: 85px; width: auto; object-fit: contain;" />
+    </a>
+    <nav class="primary-nav" aria-label="Primary">
+      <ul>
